{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "sitio",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview"
      ],
      "port": 4173
    },
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "home",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:home"
      ],
      "port": 5175,
      "autoPort": true
    },
    {
      "name": "foro",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:foro"
      ],
      "port": 5176,
      "autoPort": true
    },
    {
      "name": "reservas-api",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "tools/reservas/servidor.ts",
        "--sitio",
        "http://localhost:4180"
      ],
      "port": 54321
    },
    {
      "name": "admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:admin"
      ],
      "port": 5177,
      "autoPort": true
    },
    {
      "name": "sitio-reservas",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--config",
        "home/vite.config.js",
        "--port",
        "4180",
        "--strictPort"
      ],
      "port": 4180
    },
    {
      "name": "v1",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:v1"
      ],
      "port": 5174
    }
  ]
}