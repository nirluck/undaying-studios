# Copia este archivo como .env y llena los valores. Vite solo expone al
# navegador las variables que empiezan con VITE_.

# URL de la Edge Function de reservas. Vacía: las landings siguen con
# WhatsApp y Prospex, y el widget de reserva no se carga.
#   Producción: https://<proyecto>.supabase.co/functions/v1/api
#   Local:      http://localhost:54321/api   (npm run reservas:api)
VITE_RESERVAS_API=

# Supabase Auth para entrar al panel (/admin/). Vacías en local: el panel
# deja entrar con cualquier correo de ADMIN_CORREOS del servidor local.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
