{
  "name": "undying-studios-sitio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config estudio/vite.config.js",
    "dev:home": "vite --config home/vite.config.js",
    "dev:foro": "vite --config foro/vite.config.js",
    "dev:v1": "vite --config version01/vite.config.js",
    "build": "npm run build:home && npm run build:estudio && npm run build:foro",
    "build:home": "vite build --config home/vite.config.js",
    "build:estudio": "vite build --config estudio/vite.config.js",
    "build:foro": "vite build --config foro/vite.config.js",
    "build:v1": "vite build --config version01/vite.config.js",
    "preview": "vite preview --config home/vite.config.js",
    "sync:clips": "node tools/sync-clips.mjs"
  },
  "devDependencies": {
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.63.0",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lenis": "^1.3.26"
  }
}
