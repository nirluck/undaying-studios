{
  "name": "undying-studios-sitio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config estudio/vite.config.js",
    "dev:home": "vite --config home/vite.config.js",
    "dev:foro": "vite --config foro/vite.config.js",
    "dev:admin": "vite --config admin/vite.config.js",
    "dev:v1": "vite --config version01/vite.config.js",
    "build": "npm run build:home && npm run build:estudio && npm run build:foro && npm run build:admin",
    "build:home": "vite build --config home/vite.config.js",
    "build:estudio": "vite build --config estudio/vite.config.js",
    "build:foro": "vite build --config foro/vite.config.js",
    "build:admin": "vite build --config admin/vite.config.js",
    "build:v1": "vite build --config version01/vite.config.js",
    "preview": "vite preview --config home/vite.config.js",
    "reservas:api": "node tools/reservas/servidor.ts",
    "test:reservas": "node --test --test-concurrency=1 tools/reservas/test/*.test.ts",
    "check:reservas": "deno check --config supabase/functions/deno.json supabase/functions/api/index.ts",
    "reservas:sql": "node tools/reservas/armar-sql.mjs",
    "sync:clips": "node tools/sync-clips.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "deno": "^2.9.6",
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.63.0",
    "svelte": "^5.57.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "postgres": "^3.4.9"
  }
}
